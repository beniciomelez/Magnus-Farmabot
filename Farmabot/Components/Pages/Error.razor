@page "/Error"
@using System.Diagnostics

<PageTitle>Error | Farmabot</PageTitle>

<h1 class="text-danger">Error</h1>
<h2 class="text-danger">Se produjo un error al procesar la solicitud.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>ID de solicitud:</strong> <code>@RequestId</code>
    </p>
}

<h3>Modo de desarrollo</h3>
<p>
    Swapping to <strong>Development</strong> environment will display more detailed information about the error that occurred.
</p>
<p>
    <strong>The Development environment shouldn't be enabled for deployed applications.</strong>
    Podría mostrar información sensible a los usuarios.
    Para depurar localmente, configurá la variable <strong>ASPNETCORE_ENVIRONMENT</strong> con el valor <strong>Development</strong>
    y reiniciá la aplicación.
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
