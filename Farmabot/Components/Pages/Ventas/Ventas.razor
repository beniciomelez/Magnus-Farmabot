@page "/ventas"

<PageTitle>Ventas | Farmabot</PageTitle>

<h1 class="mb-2">Ventas</h1>
<p class="text-secondary">Registro y consulta de ventas, clientes y medicamentos vendidos.</p>
<div class="card mt-4">
    <div class="card-header fw-semibold">Historial de ventas</div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead><tr><th>Venta</th><th>Fecha</th><th>Cliente</th><th>Usuario</th><th>Total</th><th>Estado</th></tr></thead>
                <tbody><tr><td colspan="6" class="text-center text-secondary py-4">Vista preparada para conectar con ventas y venta_detalle.</td></tr></tbody>
            </table>
        </div>
    </div>
</div>
