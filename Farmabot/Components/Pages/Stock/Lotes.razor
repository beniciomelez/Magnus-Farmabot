
@page "/stock/lotes"
@rendermode InteractiveServer

@using Farmabot.Models
@using Farmabot.Services
@inject LoteMedicamentoService ServicioLotes
@inject MedicamentoService ServicioMedicamentos

<PageTitle>Gestión de lotes | Farmabot</PageTitle>

<h2 class="h4 mb-2">Gestión de lotes y stock inicial</h2>
<p class="text-secondary">
    Registrá los lotes recibidos para habilitar entradas y salidas de stock.
</p>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="alert alert-success">@mensaje</div>
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}

<div class="card mb-4">
    <div class="card-body">
        <h3 class="h5 mb-3">Registrar lote</h3>

        <EditForm Model="formulario" OnValidSubmit="RegistrarLote">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Medicamento</label>
                    <InputSelect class="form-select"
                                 @bind-Value="formulario.IdMedicamento">
                        <option value="0">Seleccionar medicamento</option>
                        @foreach (var medicamento in medicamentos)
                        {
                            <option value="@medicamento.IdMedicamento">
                                @medicamento.Nombre
                            </option>
                        }
                    </InputSelect>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Número de lote</label>
                    <InputText class="form-control"
                               @bind-Value="formulario.NumeroLote" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Fecha de vencimiento</label>
                    <InputDate class="form-control"
                               @bind-Value="formulario.FechaVencimiento" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Cantidad inicial</label>
                    <InputNumber class="form-control"
                                 @bind-Value="formulario.Stock" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Precio de compra por unidad</label>
                    <InputNumber class="form-control"
                                 @bind-Value="formulario.PrecioCompra" />
                </div>
            </div>

            <div class="d-flex justify-content-end mt-4">
                <button type="submit" class="btn btn-primary"
                        disabled="@guardando">
                    @(guardando ? "Guardando..." : "Registrar lote y stock")
                </button>
            </div>
        </EditForm>
    </div>
</div>

@if (cargando)
{
    <p>Cargando lotes...</p>
}
else if (lotes.Count == 0)
{
    <div class="alert alert-info">
        Todavía no hay lotes registrados.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Medicamento</th>
                    <th>N.º de lote</th>
                    <th>Vencimiento</th>
                    <th>Stock</th>
                    <th>Precio de compra</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lote in lotes)
                {
                    <tr>
                        <td class="fw-semibold">
                            @lote.IdMedicamentoNavigation.Nombre
                        </td>
                        <td>@lote.NumeroLote</td>
                        <td>@lote.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                        <td>@lote.Stock unidades</td>
                        <td>@lote.PrecioCompra.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Medicamento> medicamentos = new();
    private List<LotesMedicamento> lotes = new();

    private FormularioLote formulario = new();
    private bool cargando = true;
    private bool guardando;
    private string? mensaje;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            medicamentos = (await ServicioMedicamentos.ObtenerTodosAsync())
                .Where(m => m.Activo)
                .OrderBy(m => m.Nombre)
                .ToList();

            await CargarLotes();
        }
        catch (Exception ex)
        {
            error = "No se pudieron cargar los datos: " + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CargarLotes()
    {
        lotes = await ServicioLotes.ObtenerTodosAsync();
    }

    private async Task RegistrarLote()
    {
        if (guardando)
            return;

        guardando = true;
        error = null;
        mensaje = null;

        try
        {
            await ServicioLotes.RegistrarAsync(
                formulario.IdMedicamento,
                formulario.NumeroLote,
                formulario.FechaVencimiento,
                formulario.Stock,
                formulario.PrecioCompra);

            await CargarLotes();

            mensaje = "Lote registrado y stock inicial cargado correctamente.";
            formulario = new FormularioLote();
        }
        catch (Exception ex)
        {
            error = "No se pudo registrar el lote: " + ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    private class FormularioLote
    {
        public int IdMedicamento { get; set; }
        public string NumeroLote { get; set; } = string.Empty;
        public DateOnly FechaVencimiento { get; set; } =
            DateOnly.FromDateTime(DateTime.Today.AddYears(1));
        public int Stock { get; set; } = 1;
        public decimal PrecioCompra { get; set; }
    }
}
