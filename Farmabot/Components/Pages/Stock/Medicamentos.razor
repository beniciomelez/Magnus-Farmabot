@page "/stock/medicamentos"
@using Farmabot.Models
@using Farmabot.Services
@inject MedicamentoService Servicio

<h2 class="h5">Medicamentos</h2>

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-secondary mb-0">
        Gestión de medicamentos, precios, presentaciones y disponibilidad.
    </p>

    <button class="btn btn-primary" @onclick="AbrirFormulario">
        + Nuevo medicamento
    </button>
</div>

@if (mostrarFormulario)
{
    <div class="modal-backdrop-custom">
        <div class="modal-custom">
            <h3 class="h5 mb-3">Nuevo medicamento</h3>

            
            <EditForm Model="nuevoMedicamento" OnValidSubmit="GuardarMedicamento">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label">Nombre</label>
                    <InputText class="form-control"
                               @bind-Value="nuevoMedicamento.Nombre" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Descripción</label>
                    <InputText class="form-control"
                               @bind-Value="nuevoMedicamento.Descripcion" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Principio activo</label>
                    <InputText class="form-control"
                               @bind-Value="nuevoMedicamento.PrincipioActivo" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Concentración</label>
                    <InputText class="form-control"
                               @bind-Value="nuevoMedicamento.Concentracion" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Presentación</label>
                    <InputText class="form-control"
                               @bind-Value="nuevoMedicamento.Presentacion" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Laboratorio</label>
                    <InputText class="form-control"
                               @bind-Value="nuevoMedicamento.Laboratorio" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Precio de venta</label>
                    <InputNumber class="form-control"
                                 @bind-Value="nuevoMedicamento.PrecioVenta" />
                </div>

                <div class="form-check mb-3">
                    <InputCheckbox class="form-check-input"
                                   @bind-Value="nuevoMedicamento.RequiereReceta" />
                    <label class="form-check-label">Requiere receta</label>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary"
                            @onclick="CerrarFormulario">
                        Cancelar
                    </button>

                    <button type="submit" class="btn btn-primary">
                        Guardar medicamento
                    </button>
                </div>
            </EditForm>


           
        </div>
    </div>
}

<p class="text-secondary">
  
</p>

@if (cargando)
{
    <p class="text-secondary">Cargando medicamentos...</p>
}
else if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}
else if (medicamentos.Count == 0)
{
    <div class="alert alert-info">
        No hay medicamentos registrados en la base de datos.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Presentación</th>
                    <th>Categoría</th>
                    <th>Precio de venta</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var medicamento in medicamentos)
                {
                    <tr>
                        <td>@medicamento.Nombre</td>
                        <td>@medicamento.Presentacion</td>
                        <td>@(medicamento.IdCategoriaNavigation?.Nombre ?? "Sin categoría")</td>
                        <td>@medicamento.PrecioVenta.ToString("C")</td>
                        <td>
                            @if (medicamento.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Medicamento> medicamentos = new();
    private bool cargando = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            medicamentos = await Servicio.ObtenerTodosAsync();
        }
        catch (Exception)
        {
            error = ex.Message;
            Console.WriteLine(ex.ToString());
        }
        finally
        {
            cargando = false;
        }
    }

   
    private bool mostrarFormulario = false;

    private void AbrirFormulario()
    {
        mostrarFormulario = true;
    }

    private void CerrarFormulario()
    {
        mostrarFormulario = false;
    }

    private Medicamento nuevoMedicamento = new();

    private async Task GuardarMedicamento()
    {
        try
        {
            await Servicio.AgregarAsync(nuevoMedicamento);

            medicamentos = await Servicio.ObtenerTodosAsync();

            nuevoMedicamento = new Medicamento();
            CerrarFormulario();

            error = null;
        }
        catch (Exception)
        {
            error = "No se pudo guardar el medicamento. Verificá los datos ingresados.";
        }
    }

}


