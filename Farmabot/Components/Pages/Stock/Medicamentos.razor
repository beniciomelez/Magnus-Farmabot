@page "/stock/medicamentos"
@using Farmabot.Models
@using Farmabot.Services
@inject MedicamentoService Servicio

<h2 class="h5 mb-3">Gestión de medicamentos</h2>

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-secondary mb-0">
        Administrá medicamentos, categorías, precios y estados.
    </p>

    <button class="btn btn-primary" @onclick="AbrirFormulario">
        + Nuevo medicamento
    </button>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (mostrarFormulario)
{
    <div class="modal-backdrop-custom">
        <div class="modal-custom">
            <h3 class="h5 mb-3">
                @(editando ? "Editar medicamento" : "Nuevo medicamento")
            </h3>

            <EditForm Model="formulario" OnValidSubmit="GuardarMedicamento">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label">Nombre</label>
                    <InputText class="form-control"
                               @bind-Value="formulario.Nombre" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Descripción</label>
                    <InputText class="form-control"
                               @bind-Value="formulario.Descripcion" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Principio activo</label>
                    <InputText class="form-control"
                               @bind-Value="formulario.PrincipioActivo" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Concentración</label>
                    <InputText class="form-control"
                               @bind-Value="formulario.Concentracion" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Presentación</label>
                    <InputText class="form-control"
                               @bind-Value="formulario.Presentacion" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Laboratorio</label>
                    <InputText class="form-control"
                               @bind-Value="formulario.Laboratorio" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Categoría</label>
                    <InputSelect class="form-select"
                                 @bind-Value="formulario.IdCategoria">
                        <option value="0">Seleccionar categoría</option>
                        @foreach (var categoria in categorias)
                        {
                            <option value="@categoria.IdCategoria">
                                @categoria.Nombre
                            </option>
                        }
                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label class="form-label">Precio de venta</label>
                    <InputNumber class="form-control"
                                 @bind-Value="formulario.PrecioVenta" />
                </div>

                <div class="form-check mb-3">
                    <InputCheckbox class="form-check-input"
                                   @bind-Value="formulario.RequiereReceta" />
                    <label class="form-check-label">Requiere receta</label>
                </div>

                <div class="mb-3">
                    <label class="form-label">Estado</label>
                    <InputSelect class="form-select"
                                 @bind-Value="formulario.Activo">
                        <option value="true">Activo</option>
                        <option value="false">Inactivo</option>
                    </InputSelect>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary"
                            @onclick="CerrarFormulario">
                        Cancelar
                    </button>

                    <button type="submit" class="btn btn-primary">
                        @(editando ? "Guardar cambios" : "Guardar medicamento")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<div class="mb-3 d-flex gap-2">
    <button class="btn @(pestanaActiva == "Activos" ? "btn-primary" : "btn-outline-primary")"
            @onclick='() => CambiarPestana("Activos")'>
        Activos
        <span class="badge bg-light text-dark">
            @medicamentos.Count(m => m.Activo)
        </span>
    </button>

    <button class="btn @(pestanaActiva == "Inactivos" ? "btn-primary" : "btn-outline-primary")"
            @onclick='() => CambiarPestana("Inactivos")'>
        Inactivos
        <span class="badge bg-light text-dark">
            @medicamentos.Count(m => !m.Activo)
        </span>
    </button>
</div>

@if (cargando)
{
    <p class="text-secondary">Cargando medicamentos...</p>
}
else
{
    var listaFiltrada = medicamentos
        .Where(m => m.Activo == (pestanaActiva == "Activos"))
        .ToList();

    @if (listaFiltrada.Count == 0)
    {
        <div class="alert alert-info">
            No hay medicamentos en esta pestaña.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Presentación</th>
                        <th>Categoría</th>
                        <th>Precio de venta</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var medicamento in listaFiltrada)
                    {
                        <tr>
                            <td>@medicamento.Nombre</td>
                            <td>@medicamento.Presentacion</td>
                            <td>
                                @(medicamento.IdCategoriaNavigation?.Nombre
                                    ?? "Sin categoría")
                            </td>
                            <td>@medicamento.PrecioVenta.ToString("C")</td>
                            <td>
                                @if (medicamento.Activo)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactivo</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary"
                                        @onclick="() => EditarMedicamento(medicamento)">
                                    Editar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private List<Medicamento> medicamentos = new();
    private List<Categoria> categorias = new();

    private Medicamento formulario = new();
    private bool cargando = true;
    private bool mostrarFormulario;
    private bool editando;
    private string pestanaActiva = "Activos";
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await RecargarDatos();
        }
        catch (Exception ex)
        {
            error = "No se pudieron cargar los datos: " + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task RecargarDatos()
    {
        medicamentos = await Servicio.ObtenerTodosAsync();
        categorias = await Servicio.ObtenerCategoriasAsync();
    }

    private void CambiarPestana(string pestana)
    {
        pestanaActiva = pestana;
    }

    private void AbrirFormulario()
    {
        formulario = new Medicamento
        {
            Activo = true
        };

        editando = false;
        error = null;
        mostrarFormulario = true;
    }

    private void EditarMedicamento(Medicamento medicamento)
    {
        formulario = new Medicamento
        {
            IdMedicamento = medicamento.IdMedicamento,
            Nombre = medicamento.Nombre,
            Descripcion = medicamento.Descripcion,
            PrincipioActivo = medicamento.PrincipioActivo,
            Concentracion = medicamento.Concentracion,
            Presentacion = medicamento.Presentacion,
            Laboratorio = medicamento.Laboratorio,
            IdCategoria = medicamento.IdCategoria,
            PrecioVenta = medicamento.PrecioVenta,
            RequiereReceta = medicamento.RequiereReceta,
            Activo = medicamento.Activo
        };

        editando = true;
        error = null;
        mostrarFormulario = true;
    }

    private void CerrarFormulario()
    {
        mostrarFormulario = false;
        formulario = new Medicamento();
    }

    private async Task GuardarMedicamento()
    {
        try
        {
            if (formulario.IdCategoria <= 0 ||
                !categorias.Any(c => c.IdCategoria == formulario.IdCategoria))
            {
                error = "Seleccioná una categoría válida.";
                return;
            }

            if (formulario.PrecioVenta < 0)
            {
                error = "El precio no puede ser negativo.";
                return;
            }

            if (editando)
            {
                await Servicio.ActualizarAsync(formulario);
            }
            else
            {
                await Servicio.AgregarAsync(formulario);
            }

            await RecargarDatos();

            pestanaActiva = formulario.Activo ? "Activos" : "Inactivos";

            CerrarFormulario();
            error = null;
        }
        catch (Exception ex)
        {
            error = "No se pudo guardar el medicamento: " + ex.Message;
        }
    }
}
