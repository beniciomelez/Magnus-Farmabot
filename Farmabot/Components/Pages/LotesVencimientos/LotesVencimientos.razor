@page "/lotes-vencimientos"

<PageTitle>Lotes y vencimientos | Farmabot</PageTitle>

<h1 class="mb-2">Lotes y vencimientos</h1>
<p class="text-secondary">Consulta de lotes, ingresos, stock y fechas de vencimiento de los medicamentos.</p>

<div class="card mt-4">
    <div class="card-header fw-semibold">Lotes de medicamentos</div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead><tr><th>Medicamento</th><th>N.º de lote</th><th>Ingreso</th><th>Vencimiento</th><th>Stock</th><th>Precio de compra</th></tr></thead>
                <tbody><tr><td colspan="6" class="text-center text-secondary py-4">Vista preparada. Todavía no se consultan registros de la base de datos.</td></tr></tbody>
            </table>
        </div>
    </div>
</div>
